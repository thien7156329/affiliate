{
  "name": "affiliate-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Gemini/Veo video pipeline: upload to S3, save metadata, publish to TikTok",
  "main": "build/bootstrap.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND,SHORTS-KIT\" -c \"cyan.bold,magenta.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:shorts\"",
    "dev:server": "npx nodemon --watch src -e ts --exec 'npx tsx src/bootstrap.ts'",
    "dev:client": "npm --prefix client run dev",
    "dev:shorts": "export PATH=\"$HOME/.bun/bin:/opt/homebrew/bin:$PATH\" && (lsof -ti:7788 | xargs kill -9 2>/dev/null || true) && cd shorts-kit && bun --watch scripts/preview.ts",
    "dev:bridge": "npx tsx src/workspaceBridge.ts",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "tsc",
    "start": "node build/bootstrap.js",
    "start:bridge": "node build/workspaceBridge.js",
    "lint": "tsc --noEmit",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d"
  },
  "keywords": [
    "mcp",
    "s3",
    "tiktok",
    "affiliate",
    "gemini",
    "veo"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^182.0.0",
    "localtunnel": "^2.0.2",
    "openai": "^7.10.0",
    "puppeteer": "^25.6.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
