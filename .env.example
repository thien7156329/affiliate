# AWS S3 Configuration
PORT=3400
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET_NAME=your-bucket-name
S3_KEY_PREFIX=videos/

# TikTok (mock mode if not set or set to "mock")
TIKTOK_API_KEY=mock
TIKTOK_OPEN_ID=mock

# Gemini Flash API Key (miễn phí từ aistudio.google.com)
# Dùng để sinh Veo prompt tự động từ tên sản phẩm
GEMINI_API_KEY=your_gemini_api_key_here

# Puppeteer Chrome Config
# Đường dẫn User Data Directory của Chrome trên Mac (chứa session đã login Gemini Ultra)
CHROME_USER_DATA_DIR=/Users/YOUR_USERNAME/Library/Application Support/Google/Chrome
# Profile Chrome đã đăng nhập Gemini Ultra (Default, Profile 1, Profile 2...)
CHROME_PROFILE=Default
# Đường dẫn Chrome executable (để trống nếu dùng default /Applications/Google Chrome.app)
CHROME_EXECUTABLE_PATH=

# Cronjob Scheduler
# Cron expression cho lịch chạy tự động (mặc định: 8h, 12h, 18h mỗi ngày)
CRON_SCHEDULE=0 8,12,18 * * *
# Đặt thành "true" để tắt scheduler khi develop/test
DISABLE_SCHEDULER=true

# Local multi-project source browser + MCP bridge
WORKSPACE_BRIDGE_HOST=127.0.0.1
WORKSPACE_BRIDGE_PORT=3410
# Set true only when publishing through an HTTPS tunnel. This exposes /mcp only.
WORKSPACE_BRIDGE_PUBLIC=false
# Required when exposing the bridge beyond localhost. Generate a long random value.
WORKSPACE_BRIDGE_TOKEN=
# First run automatically registers this repository. Set false for an empty registry.
WORKSPACE_BRIDGE_ADD_CWD=true
WORKSPACE_BRIDGE_MAX_FILE_BYTES=2097152
WORKSPACE_BRIDGE_MAX_TREE_ENTRIES=5000
# Primary AI provider for prompt/copy generation. GLM-5 remains the independent auditor.
AGY_ENABLED=true
AGY_CLI_PATH=agy
AGY_MODEL=gemini-3.8-flash-high
AGY_TIMEOUT_MS=300000

# Facebook Graph API (Đăng Video/Reels lên Fanpage)
# Lấy Access Token từ Meta for Developers > Graph API Explorer (quyền pages_show_list, pages_read_engagement, pages_manage_posts)
FB_ACCESS_TOKEN=
# (Tùy chọn) ID của Fanpage muốn đăng. Để trống nếu muốn hệ thống tự động chọn Page từ Token
FB_PAGE_ID=

